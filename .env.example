# Optional environment variables — copy to .env.local for local dev,
# or set in Vercel → Settings → Environment Variables.

# Session signing secret (change this in production!)
AUTH_SECRET=change-me-to-a-long-random-string

# Sophie AI upgrade + Whisper audio transcription (optional — local finance engine works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Public URL for Twilio Voice webhooks (optional — auto-detected from forwarded headers)
PUBLIC_BASE_URL=

# Automated WhatsApp delivery via Twilio (optional — wa.me links work without it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
